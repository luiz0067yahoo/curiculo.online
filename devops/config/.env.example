# ==============================================================================
# ENVIRONMENT CONFIGURATION TEMPLATE - CURRICULO.ONLINE
# ==============================================================================

# Application Environment (development | production | staging)
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8000

# Backend Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# Database Configuration (MySQL 8.0)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=curriculo_online
DB_USER=root
DB_PASS=

# Fallback Resilient Storage (when MySQL is inactive)
STORAGE_MODE=auto
STORAGE_PATH=backend/data_storage

# Frontend Configuration
FRONTEND_PORT=3000
VITE_API_URL=/api

# Internationalization Default (pt | en | es | it)
DEFAULT_LANG=pt
AUTO_DETECT_BROWSER_LANG=true

# Security & CORS
CORS_ALLOWED_ORIGINS=*
SESSION_LIFETIME=86400
